// lib/config/app_secrets.dart
// Copy this file to app_secrets.dart and fill in your real API keys.

class AppSecrets {
  // Naver Map SDK (flutter_naver_map)
  static const String naverMapClientId = 'YOUR_NAVER_MAP_CLIENT_ID';

  // Kakao SDK
  static const String kakaoNativeAppKey = 'YOUR_KAKAO_NATIVE_APP_KEY';

  // Naver Search API (openapi.naver.com)
  static const String naverSearchClientId = 'YOUR_NAVER_SEARCH_CLIENT_ID';
  static const String naverSearchClientSecret = 'YOUR_NAVER_SEARCH_CLIENT_SECRET';

  // Salt used to derive Firebase Auth passwords from social login IDs
  static const String authSalt = 'YOUR_AUTH_SALT';
}
